{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://fauran-delivery-app-apis.vercel.app/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://fauran-delivery-app-apis.vercel.app/uploads/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
